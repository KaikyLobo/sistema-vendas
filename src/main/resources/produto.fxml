<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550.0" prefWidth="700.0" style="-fx-background-color: #172554;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

   <VBox alignment="CENTER" prefWidth="500.0" spacing="15.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="50.0">

      <Label style="-fx-text-fill: white;                       -fx-font-size: 26px;                       -fx-font-weight: bold;" text="Sistema de Vendas - Cadastro de Produto" />

      <Label alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-text-fill: white;                       -fx-font-size: 16px;" text="Nome" />

      <TextField prefHeight="40.0" promptText="Digite o nome do produto" style="-fx-background-color: ffff;" />

      <Label alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-text-fill: white;                       -fx-font-size: 16px;" text="Preço" />

      <TextField prefHeight="40.0" promptText="Digite o preço" style="-fx-background-color: fff;" />

      <Label alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-text-fill: white;                       -fx-font-size: 16px;" text="Quantidade em estoque" />

      <TextField prefHeight="40.0" promptText="Digite a quantidade" style="-fx-background-color: fff;" />

      <!-- Área do botão -->
      <HBox alignment="CENTER_RIGHT" VBox.vgrow="NEVER">

         <Button prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #2563eb;                            -fx-text-fill: white;                            -fx-font-size: 16px;                            -fx-font-weight: bold;                            -fx-background-radius: 5px;" text="Salvar" />

      </HBox>

   </VBox>

</AnchorPane>
